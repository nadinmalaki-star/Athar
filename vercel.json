{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/clue/saad-maslamani",
      "destination": "https://athar-clue-engine.vercel.app/clue/saad-maslamani"
    },
    {
      "source": "/clue/saad-maslamani/",
      "destination": "https://athar-clue-engine.vercel.app/clue/saad-maslamani"
    },
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": { "re": "^https://studioathar\\.studio/clue/saad-maslamani/?" }
        }
      ],
      "destination": "https://athar-clue-engine.vercel.app/app/:path*"
    },
    {
      "source": "/clue-engine/:path*",
      "has": [
        {
          "type": "header",
          "key": "referer",
          "value": { "re": "^https://studioathar\\.studio/clue/saad-maslamani/?" }
        }
      ],
      "destination": "https://athar-clue-engine.vercel.app/clue-engine/:path*"
    }
  ],
  "redirects": [
    { "source": "/clue/abu-mazen", "destination": "https://athar-clue-engine.vercel.app/clue/abu-mazen-small-detail", "permanent": false },
    { "source": "/clue/nativity-bells", "destination": "https://athar-clue-engine.vercel.app/clue/nativity-bells", "permanent": false },
    { "source": "/clue/ararat-hotel", "destination": "https://athar-clue-engine.vercel.app/clue/ararat-hotel", "permanent": false },
    { "source": "/clue/emobility", "destination": "https://athar-clue-engine.vercel.app/clue/athar-emobility-digital-clue-v2-verified-fixed-final-client-facing-ready", "permanent": false },
    { "source": "/clue/gac-aion", "destination": "https://athar-clue-engine.vercel.app/clue/athar-gac-digital-clue-v2-verified-fixed-final-client-facing-ready", "permanent": false },
    { "source": "/clue/im-motors", "destination": "https://athar-clue-engine.vercel.app/clue/athar-im-digital-clue-v2-verified-fixed-final-client-facing-ready", "permanent": false },
    { "source": "/clue/smart", "destination": "https://athar-clue-engine.vercel.app/clue/athar-smart-digital-clue-v2-verified-fixed-final-client-facing-ready", "permanent": false }
  ]
}
