{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/clue/abu-mazen",
      "destination": "https://athar-clue-engine.vercel.app/clue/abu-mazen-small-detail",
      "permanent": false
    },
    {
      "source": "/clue/nativity-bells",
      "destination": "https://athar-clue-engine.vercel.app/clue/nativity-bells",
      "permanent": false
    },
    {
      "source": "/clue/ararat-hotel",
      "destination": "https://athar-clue-engine.vercel.app/clue/ararat-hotel",
      "permanent": false
    }
  ]
}
